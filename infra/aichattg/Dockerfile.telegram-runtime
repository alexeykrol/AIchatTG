FROM node:20.20.0-bookworm-slim

ARG AICHATTG_SOURCE_SHA
LABEL org.opencontainers.image.source="https://github.com/alexeykrol/AIchatTG" \
      org.opencontainers.image.revision="${AICHATTG_SOURCE_SHA}" \
      org.opencontainers.image.title="aichattg-telegram-runtime"

WORKDIR /app/apps/telegram-runtime
ENV NODE_ENV=production

COPY apps/telegram-runtime/package.json apps/telegram-runtime/package-lock.json ./
COPY packages/telegram-core/ /app/packages/telegram-core/
RUN npm ci --omit=dev

COPY apps/telegram-runtime/src/ ./src/
RUN chown -R node:node /app

USER node
EXPOSE 8788
CMD ["node", "src/server.mjs"]
