FROM node:20.20.0-bookworm-slim

ARG AICHATTG_SOURCE_SHA
LABEL org.opencontainers.image.source="https://github.com/alexeykrol/AIchatTG" \
      org.opencontainers.image.revision="${AICHATTG_SOURCE_SHA}" \
      org.opencontainers.image.title="aichattg-operator-console"

WORKDIR /app/apps/operator-console
ENV NODE_ENV=production

COPY apps/operator-console/package.json apps/operator-console/package-lock.json ./
RUN npm ci --omit=dev

COPY apps/operator-console/src/ ./src/
COPY apps/operator-console/public/ ./public/
RUN chown -R node:node /app

USER node
EXPOSE 8790
CMD ["node", "src/server.mjs"]
