FROM node:20.20.0-bookworm-slim

ARG AICHATTG_SOURCE_SHA
LABEL org.opencontainers.image.source="https://github.com/alexeykrol/AIchatTG" \
      org.opencontainers.image.revision="${AICHATTG_SOURCE_SHA}" \
      org.opencontainers.image.title="aichattg-join-gatekeeper"

WORKDIR /app/apps/join-gatekeeper
ENV NODE_ENV=production

COPY apps/join-gatekeeper/package.json apps/join-gatekeeper/package-lock.json ./
RUN npm ci --omit=dev

COPY apps/join-gatekeeper/src/ ./src/
COPY apps/join-gatekeeper/JOIN_SCENARIO.json ./JOIN_SCENARIO.json
RUN chown -R node:node /app

USER node
EXPOSE 8788
CMD ["node", "src/server.mjs"]
