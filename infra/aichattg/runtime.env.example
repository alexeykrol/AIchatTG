# Template only. Keep the real runtime file outside Git with mode 0600.
# Product Owner-approved public hostname. The real runtime file stays outside Git.
AICHATTG_SOURCE_SHA=REPLACE_WITH_EXACT_40_CHARACTER_GIT_SHA
AICHATTG_FQDN=aikrol.questtales.com
# This exact HTTPS origin is used only by the explicit Telegram operations CLI.
# It does not register a webhook during normal runtime startup.
AICHATTG_PUBLIC_ORIGIN=https://aikrol.questtales.com
AICHATTG_DATA_ROOT=/srv/aichattg/data

# Both routers are fail-closed. Enabling either one requires an exact cutover lease.
AICHATTG_GATEKEEPER_ROUTING_ENABLED=false
AICHATTG_RUNTIME_ROUTING_ENABLED=false
AICHATTG_OPERATOR_CONSOLE_ROUTING_ENABLED=false

# Read-only bot-operations console. It is unavailable unless this token is set
# in the private runtime file; use it only with a separately approved route.
AICHATTG_OPERATOR_TOKEN=REPLACE_AT_RUNTIME

# Gatekeeper values are required before its Compose profile can start.
# Compose alone selects the reviewed container bind and derives
# GATEKEEPER_PUBLIC_ORIGIN from this file's AICHATTG_FQDN. Do not set either
# value separately in a local shell or runtime file.
GATEKEEPER_BOT_TOKEN=REPLACE_AT_RUNTIME
GATEKEEPER_BOT_USERNAME=REPLACE_AT_RUNTIME
GATEKEEPER_TARGET_CHAT_ID=REPLACE_AT_RUNTIME
GATEKEEPER_TELEGRAM_WEBHOOK_SECRET=REPLACE_AT_RUNTIME
GATEKEEPER_TRIBUTE_API_KEY=REPLACE_AT_RUNTIME
GATEKEEPER_TRIBUTE_SUBSCRIPTION_IDS=REPLACE_AT_RUNTIME
GATEKEEPER_LINK_SIGNING_SECRET=REPLACE_AT_RUNTIME
GATEKEEPER_SITE_ENABLED=false
GATEKEEPER_ZAPIER_ENABLED=false

# Runtime starts without Telegram ingress, polling, provider calls, or notifications.
TELEGRAM_RUNTIME_INGRESS_ENABLED=false
TELEGRAM_RUNTIME_MODERATION_MODE=shadow
TELEGRAM_RUNTIME_MODERATION_ANTICHANNELPIN=true
# Moderator and Assistant are two separate bot identities. Never reuse their
# tokens or webhook secrets; all values stay in the private 0600 runtime file.
TELEGRAM_RUNTIME_MODERATOR_BOT_TOKEN=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_MODERATOR_BOT_USERNAME=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_MODERATOR_CHAT_IDS=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_MODERATOR_WEBHOOK_SECRET=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_ASSISTANT_BOT_TOKEN=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_ASSISTANT_BOT_USERNAME=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_ASSISTANT_CHAT_IDS=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_ASSISTANT_WEBHOOK_SECRET=REPLACE_AT_RUNTIME
# This worker only re-attempts a ProviderUnavailableError that is known to be
# pre-request. Calling, malformed and transport/HTTP provider outcomes require
# manual review and no Telegram effect is replayed.
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_INTERVAL_SEC=60
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_BATCH_SIZE=10
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_LEASE_SEC=90
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_MAX_SAFE_RETRIES=3
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_BACKOFF_SEC=60
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_SNAPSHOT_TTL_SEC=604800
TELEGRAM_RUNTIME_PROVIDER_ENABLED=false
TELEGRAM_RUNTIME_PROVIDER_VENDOR=openai
TELEGRAM_RUNTIME_PROVIDER_ENDPOINT=REPLACE_WITH_APPROVED_HTTPS_V1_ENDPOINT
TELEGRAM_RUNTIME_PROVIDER_API_KEY=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_PROVIDER_MODERATOR_SAFETY_MODEL=gpt-5.6-terra
TELEGRAM_RUNTIME_PROVIDER_MODERATOR_SAFETY_REASONING_EFFORT=medium
TELEGRAM_RUNTIME_PROVIDER_MODERATOR_SAFETY_MAX_OUTPUT_TOKENS=1024
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ROUTER_MODEL=REPLACE_WITH_APPROVED_MODEL
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ROUTER_REASONING_EFFORT=REPLACE_WITH_APPROVED_EFFORT
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ROUTER_MAX_OUTPUT_TOKENS=REPLACE_WITH_APPROVED_LIMIT
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ANSWER_MODEL=REPLACE_WITH_APPROVED_MODEL
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ANSWER_REASONING_EFFORT=REPLACE_WITH_APPROVED_EFFORT
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ANSWER_MAX_OUTPUT_TOKENS=REPLACE_WITH_APPROVED_LIMIT
TELEGRAM_RUNTIME_NOTIFICATIONS_ENABLED=false
