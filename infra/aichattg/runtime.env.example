# Template only. Keep the real runtime file outside Git with mode 0600.
# Product Owner-approved public hostname. The real runtime file stays outside Git.
AICHATTG_SOURCE_SHA=REPLACE_WITH_EXACT_40_CHARACTER_GIT_SHA
AICHATTG_FQDN=aikrol.questtales.com
# This exact HTTPS origin is used only by the explicit Telegram operations CLI.
# It does not register a webhook during normal runtime startup.
AICHATTG_PUBLIC_ORIGIN=https://aikrol.questtales.com
AICHATTG_DATA_ROOT=/srv/aichattg/data
# Separate read-only admission root. It may stay empty while knowledge is off.
AICHATTG_KNOWLEDGE_ROOT=/srv/aichattg/knowledge

# Both routers are fail-closed. Enabling either one requires an exact cutover lease.
AICHATTG_GATEKEEPER_ROUTING_ENABLED=false
AICHATTG_RUNTIME_ROUTING_ENABLED=false
AICHATTG_OPERATOR_CONSOLE_ROUTING_ENABLED=false

# Read-only bot-operations console. It is unavailable unless this token is set
# in the private runtime file; use it only with a separately approved route.
AICHATTG_OPERATOR_TOKEN=REPLACE_AT_RUNTIME

# Gatekeeper values are required before its Compose profile can start.
# Compose alone selects the reviewed container bind and derives
# GATEKEEPER_PUBLIC_ORIGIN from this file's AICHATTG_FQDN. Do not set either
# value separately in a local shell or runtime file.
GATEKEEPER_BOT_TOKEN=REPLACE_AT_RUNTIME
GATEKEEPER_BOT_USERNAME=REPLACE_AT_RUNTIME
GATEKEEPER_TARGET_CHAT_ID=REPLACE_AT_RUNTIME
GATEKEEPER_TELEGRAM_WEBHOOK_SECRET=REPLACE_AT_RUNTIME
GATEKEEPER_TRIBUTE_API_KEY=REPLACE_AT_RUNTIME
GATEKEEPER_TRIBUTE_SUBSCRIPTION_IDS=REPLACE_AT_RUNTIME
GATEKEEPER_LINK_SIGNING_SECRET=REPLACE_AT_RUNTIME
GATEKEEPER_SITE_ENABLED=false
GATEKEEPER_ZAPIER_ENABLED=false

# Runtime starts without Telegram ingress, polling, provider calls, or notifications.
TELEGRAM_RUNTIME_INGRESS_ENABLED=false
TELEGRAM_RUNTIME_MODERATION_MODE=shadow
TELEGRAM_RUNTIME_MODERATION_ANTICHANNELPIN=true
# Moderator and Assistant are two separate bot identities. Never reuse their
# tokens or webhook secrets; all values stay in the private 0600 runtime file.
TELEGRAM_RUNTIME_MODERATOR_BOT_TOKEN=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_MODERATOR_BOT_USERNAME=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_MODERATOR_CHAT_IDS=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_MODERATOR_WEBHOOK_SECRET=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_ASSISTANT_BOT_TOKEN=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_ASSISTANT_BOT_USERNAME=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_ASSISTANT_CHAT_IDS=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_ASSISTANT_WEBHOOK_SECRET=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_ASSISTANT_COOLDOWN_SEC=20
TELEGRAM_RUNTIME_ASSISTANT_DAILY_PER_USER=20
TELEGRAM_RUNTIME_ASSISTANT_KNOWLEDGE_ENABLED=false
# Синтетический пользователь — бот, который ведёт диалоги в тестовом чате.
# Ассистент по конструкции не отвечает ботам, поэтому нужен явный именованный
# список: только эти id проходят барьер (собственный бот и EXEMPT сильнее).
# В бою флаг выключен, а непустой список при выключенном флаге роняет старт —
# чтобы забытый список не заработал молча.
TELEGRAM_RUNTIME_SYNTHETIC_TESTING_ENABLED=false
TELEGRAM_RUNTIME_ASSISTANT_SYNTHETIC_BOT_IDS=
# Корень допуска знания. Все манифесты обязаны лежать ПОД ним — иначе рантайм
# падает на старте (это гард от чтения произвольного файла, а не придирка).
#
# ДВА РАЗНЫХ ПУТИ, не путать (правка 2026-08-16 по сверке с compose):
#   AICHATTG_KNOWLEDGE_ROOT выше — путь НА ХОСТЕ (что монтируем; на проде это
#     /home/agent/aichattg/knowledge, потому что у владельца процесса нет sudo);
#   всё, что ниже, — пути ВНУТРИ КОНТЕЙНЕРА. Compose монтирует хостовый корень
#     в /var/lib/aichattg/knowledge и сам выставляет TELEGRAM_RUNTIME_KNOWLEDGE_ROOT
#     этим значением, поэтому значения ниже обязаны быть /var/lib-путями.
#     Хостовый путь, попавший сюда, роняет старт: «must name a file below
#     TELEGRAM_RUNTIME_KNOWLEDGE_ROOT».
TELEGRAM_RUNTIME_KNOWLEDGE_ROOT=/var/lib/aichattg/knowledge
# Fill these only after a separately reviewed knowledge snapshot is admitted.
TELEGRAM_RUNTIME_KNOWLEDGE_CONTENT_MANIFEST_PATH=/var/lib/aichattg/knowledge/course-content.manifest.json
TELEGRAM_RUNTIME_KNOWLEDGE_CONTENT_MANIFEST_SHA256=
TELEGRAM_RUNTIME_KNOWLEDGE_OPERATIONS_MANIFEST_PATH=/var/lib/aichattg/knowledge/manifest.json
TELEGRAM_RUNTIME_KNOWLEDGE_OPERATIONS_MANIFEST_SHA256=

# --- Срезы знания: операционный домен и домен пользы ---------------------------
# Срез подменяет ровно свой источник поверх пакета уроков: org — операционный
# (оплата, запись, доступ), value — пользу для роли. Поиск по урокам их НЕ видит:
# ретривер строится от пакета, а не от склейки.
# Пустая переменная — законная конфигурация: срез не подключается, бот работает
# на одном пакете уроков. Но ЗАДАННЫЙ и не принятый срез (битый JSON, чужая
# схема, негабаритный файл) роняет старт: у нас уже был класс дефекта «тихая
# пустота», когда бот выглядел исправным, а домена в нём не было.
# Оба пути обязаны лежать ПОД TELEGRAM_RUNTIME_KNOWLEDGE_ROOT — тот же гард от
# чтения произвольного файла, что и у манифестов выше.
TELEGRAM_RUNTIME_KNOWLEDGE_ORG_SLICE_PATH=
TELEGRAM_RUNTIME_KNOWLEDGE_VALUE_SLICE_PATH=

# --- База знаний курса: бинарный пакет (формат v2) и ретривер -----------------
# Пакет собирает лаборатория (allcourses) и кладёт рядом с ним knowledge.manifest.json.
# Digest — из этого манифеста (поле packageDigest); рантайм пересчитывает sha256
# каждого файла и не поверит манифесту на слово.
# Без RETRIEVAL_ENABLED=true всё работает как раньше: это откат одним флагом.
TELEGRAM_RUNTIME_ASSISTANT_RETRIEVAL_ENABLED=false
TELEGRAM_RUNTIME_KNOWLEDGE_PACKAGE_MANIFEST_PATH=/var/lib/aichattg/knowledge/ai/knowledge.manifest.json
TELEGRAM_RUNTIME_KNOWLEDGE_PACKAGE_DIGEST_SHA256=
# Сколько материала уходит в модель. 12 записей — то, на чём измерен голд-сет;
# менять эти числа значит менять систему, для которой измерены R@5 и воздержание.
TELEGRAM_RUNTIME_ASSISTANT_RETRIEVAL_MAX_ENTRIES=12
TELEGRAM_RUNTIME_ASSISTANT_RETRIEVAL_MAX_CONTEXT_TOKENS=6000
# Валидация пака по схеме из самого пакета. Включена: она уже поймала пак,
# не проходивший собственный контракт.
TELEGRAM_RUNTIME_ASSISTANT_RETRIEVAL_VALIDATE_PACKS=true
# Переформулировка вопроса и один повторный поиск (шаг 5): +0.046 к R@5 на
# замере, но это ЛИШНИЙ платный вызов на каждом молчании. Включать осознанно.
TELEGRAM_RUNTIME_ASSISTANT_RETRIEVAL_REWRITE_ENABLED=false
TELEGRAM_RUNTIME_REWRITE_MODEL=gpt-5.6-terra
TELEGRAM_RUNTIME_REWRITE_REASONING_EFFORT=minimal
# This worker only re-attempts a ProviderUnavailableError that is known to be
# pre-request. Calling, malformed and transport/HTTP provider outcomes require
# manual review and no Telegram effect is replayed.
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_INTERVAL_SEC=60
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_BATCH_SIZE=10
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_LEASE_SEC=90
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_MAX_SAFE_RETRIES=3
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_BACKOFF_SEC=60
TELEGRAM_RUNTIME_MODERATOR_RECOVERY_SNAPSHOT_TTL_SEC=604800
TELEGRAM_RUNTIME_PROVIDER_ENABLED=false
TELEGRAM_RUNTIME_PROVIDER_VENDOR=openai
TELEGRAM_RUNTIME_PROVIDER_ENDPOINT=REPLACE_WITH_APPROVED_HTTPS_V1_ENDPOINT
TELEGRAM_RUNTIME_PROVIDER_API_KEY=REPLACE_AT_RUNTIME
TELEGRAM_RUNTIME_PROVIDER_MODERATOR_SAFETY_MODEL=gpt-5.6-terra
TELEGRAM_RUNTIME_PROVIDER_MODERATOR_SAFETY_REASONING_EFFORT=medium
TELEGRAM_RUNTIME_PROVIDER_MODERATOR_SAFETY_MAX_OUTPUT_TOKENS=1024
# Роутер выбирает одно из четырёх действий и источник — узкое решение на коротком
# входе, поэтому усилие низкое, а вывод ограничен: длинный ответ здесь означал бы,
# что модель делает не свою работу.
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ROUTER_MODEL=gpt-5.6-terra
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ROUTER_REASONING_EFFORT=low
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ROUTER_MAX_OUTPUT_TOKENS=256
# Ответ собирает связный текст со ссылками на уроки из уже отобранных фрагментов.
# Это синтез из данного, а не поиск решения: где искать — уже решено ретривером,
# факты лежат перед моделью. Такая задача выигрывает от аккуратности, а не от
# глубокого перебора, поэтому medium. Проверить это можно только замером на живых
# диалогах — прогнать те же вопросы на high и сравнить ответы.
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ANSWER_MODEL=gpt-5.6-terra
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ANSWER_REASONING_EFFORT=medium
TELEGRAM_RUNTIME_PROVIDER_ASSISTANT_ANSWER_MAX_OUTPUT_TOKENS=2048
TELEGRAM_RUNTIME_NOTIFICATIONS_ENABLED=false
